# Adds "Enqueue in Amplitude" to the right-click menu of audio files and
# folders in KDE's file manager (a KIO "service menu"). Other desktops
# ignore this file. Keep the types in step with amplitude.desktop.
[Desktop Entry]
Type=Service
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/wav;audio/x-wav;audio/ogg;audio/x-vorbis+ogg;audio/x-opus+ogg;audio/mp4;audio/x-m4a;audio/aac;audio/x-mod;audio/x-xm;audio/x-s3m;audio/x-it;audio/x-mpegurl;inode/directory;
Actions=enqueue
X-KDE-Priority=TopLevel

[Desktop Action enqueue]
Name=Enqueue in Amplitude
Icon=amplitude
Exec=amplitude --enqueue %F
